    <!-- First run -->
    <string name="onboarding_title">Wissen, welche Farbe es ist</string>
    <string name="onboarding_subtitle">Drei Dinge, die du wissen solltest. Dauert zehn Sekunden.</string>
    <string name="onboarding_step1_title">Richte die Kamera auf etwas</string>
    <string name="onboarding_step1_body">Der Name erscheint in einfachen Worten, zum Beispiel „Dunkelblau“.</string>
