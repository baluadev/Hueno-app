<resources>
    <!-- The app theme once the first frame is drawn. Screens are styled in Compose. AppCompat,
         because the activity is an AppCompatActivity so the in-app language works on every
         Android version. -->
    <style name="Theme.Hueno" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- What the system shows while the app starts: the mark on the dark tile color. The animated
         intro in SplashOverlay picks up from exactly this picture. -->
    <style name="Theme.Hueno.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Hueno</item>
    </style>
</resources>
